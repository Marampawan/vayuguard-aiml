# VayuGuard Environment Configuration
# Copy this file to .env and fill in your actual values

# qBraid Quantum Cloud Platform
QBRAID_API_KEY=your_qbraid_api_key_here

# Open-Meteo API (optional - public API, no key required)
# OPENMETEO_API_KEY=your_key_here

# Application Settings
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database (if applicable)
# DATABASE_URL=postgresql://user:pass@localhost:5432/vayuguard

# API Keys for external services
# WEATHER_API_KEY=your_weather_api_key
# AIR_QUALITY_API_KEY=your_air_quality_api_key